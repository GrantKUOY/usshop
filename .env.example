# 資料庫連線（應用層角色：對只增不改的表僅有 SELECT／INSERT）。換 Neon 只改這行。
DATABASE_URL=postgres://usshop_app:apppass@localhost:5433/usshop
# 遷移／種子用（表擁有者；Neon 請填 owner 連線字串）。應用程式執行時不使用。
MIGRATE_DATABASE_URL=postgres://usshop_admin:devpass@localhost:5433/usshop

# 站台對外網址（產生邀請連結用）
PUBLIC_BASE_URL=http://localhost:4321

# 邀請連結有效時數（預設 336 = 14 天，待 Grant 確認）
INVITE_TTL_HOURS=336
# 家人／管理員工作階段有效時數
FAMILY_SESSION_HOURS=4320
ADMIN_SESSION_HOURS=12

# 種子資料用管理員初始密碼（僅本機示範；正式環境請另設並於登入後更換）
SEED_ADMIN_PASSWORD=dev-admin-pass

# 預設埠（astro dev）
PORT=4321
