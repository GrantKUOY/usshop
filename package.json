{
  "name": "usshop",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "test:unit": "tsx --test tests/estimate.test.ts",
    "test:api": "tsx --env-file=.env --test tests/api.test.ts",
    "start": "node --env-file=.env dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
